<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    tools:context=".MainActivity">

    <!-- Video Player - Full Screen -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        app:use_controller="false" />

    <!-- 运维层兜底面板（整屏正中）：只在屏上没有任何在播窗口时显示（启动、欢迎视频、
         退出到桌面退化黑屏）。有窗口时由 MainActivity 在**每扇窗正中**各放一份同样的面板，
         这个 XML 面板就让位（见 refreshWindowStatusOverlays / applyStatusUi）。
         默认 gone 是安全侧：关掉调试的设备连启动第一帧都不会把运维文字画到投影上。
         显隐只由 applyStatusUi() 按 prefs.debug_mode + 当前状态决定。 -->
    <LinearLayout
        android:id="@+id/statusPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#B3000000"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="3"
            android:padding="14dp"
            android:text="初始化中…"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <!-- 素材同步进度条：轨道半透明灰，只让绿色填充显眼；宽度由代码按屏宽缩放 -->
        <ProgressBar
            android:id="@+id/syncProgressBar"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="360dp"
            android:layout_height="8dp"
            android:layout_marginTop="10dp"
            android:max="100"
            android:progress="0"
            android:progressTint="#4CAF50"
            android:progressBackgroundTint="#33FFFFFF"
            android:visibility="gone" />
    </LinearLayout>

</FrameLayout>
